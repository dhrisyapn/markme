# Supabase Configuration Template for MarkMe
# Copy this file to .env and replace placeholders with your actual Supabase credentials.
DB_URL=postgresql://postgres.<project-id>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
PROJECT_ID=<your-project-id>
PROJECT_REGION=<your-region>
ANON_KEY=<your-anon-key>
SERVICE_ROLE=<your-service-role-key>
PROJECT_URL=https://<your-project-id>.supabase.co

# Backward-compatibility aliases
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
